# ==============================================================
# UnSpoken — Environment Configuration
# A place for everything left unsaid.
# ==============================================================

# 1. Supabase PostgreSQL Configuration
# Create a Supabase project at https://supabase.com and run `supabase/schema.sql`.
# If left empty, UnSpoken operates seamlessly in local persistent fallback mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Administrative Security
# Secret passcode required to access the /admin moderation portal.
ADMIN_SECRET_KEY=unspoken-admin-safe-2026

# 3. Environment
NODE_ENV=development
